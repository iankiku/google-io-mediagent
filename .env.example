# Google AI
GEMINI_API_KEY=your-gemini-api-key

# PostgreSQL (pgvector)
POSTGRES_HOST=localhost
POSTGRES_DB=health_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Google Cloud Storage (optional — falls back to local filesystem)
GCS_BUCKET_NAME=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# GCP (used by Pulumi)
GCP_PROJECT=mediagent-hackathon
GCP_REGION=us-central1

# Vapi (voice agents) — required for the "Talk to Agent instead" button on
# /talk/appointment-return. The PRIVATE key is used server-side to create
# assistants via POST https://api.vapi.ai/assistant. The PUBLIC key is read
# server-side too, returned to the browser, then used to init the
# @vapi-ai/web SDK for the live call. Get both from https://dashboard.vapi.ai
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
