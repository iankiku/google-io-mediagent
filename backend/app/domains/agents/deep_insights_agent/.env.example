# Required for HyDE, reranking, and managed-agent synthesis
GEMINI_API_KEY=your-gemini-api-key

# Required for pgvector retrieval (defaults match root .env.example / docker compose)
POSTGRES_HOST=localhost
POSTGRES_DB=health_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# HyDE loop and reranker output size (PRD target is 5 iterations; default is 2)
DEEP_INSIGHTS_K_ITERATIONS=2
DEEP_INSIGHTS_TOP_K=2

# Optional override for synthesis (defaults to app.core.config.DEFAULT_BASE_AGENT)
DEEP_INSIGHTS_MANAGED_AGENT_ID=antigravity-preview-05-2026
