# Gemini is required twice in this prototype:
# 1) routing the query to the two best public sources
# 2) synthesizing the final answer from retrieved evidence
GEMINI_API_KEY=[REDACTED]
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GOOGLE_SEARCH_GROUNDING=false

# Router / retrieval controls
ROUTER_SOURCE_COUNT=2
TOP_K_PER_SOURCE=5
REQUEST_TIMEOUT_SECONDS=30

# Optional, but recommended for polite MedlinePlus usage
MEDLINEPLUS_TOOL=medical-rag-prototype
MEDLINEPLUS_EMAIL=[REDACTED]

# Public API bases (defaults shown here explicitly)
MEDLINEPLUS_WEBSERVICE_BASE=https://wsearch.nlm.nih.gov/ws/query
MEDLINEPLUS_CONNECT_BASE=https://connect.medlineplus.gov/service
DAILYMED_BASE=https://dailymed.nlm.nih.gov/dailymed/services/v2
OPENFDA_BASE=https://api.fda.gov/drug/label.json
# Optional higher-volume key; not required for normal use
OPENFDA_API_KEY=
MESH_LOOKUP_BASE=https://id.nlm.nih.gov/mesh/lookup/descriptor
RXNAV_BASE=https://rxnav.nlm.nih.gov/REST
